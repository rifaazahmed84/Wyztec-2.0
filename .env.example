PORT=3001
# Optional HOST=0.0.0.0 for containers / external development access
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SITE_URL=http://localhost:5173
# Server only. Supabase Project Settings > Data API and API Keys.
# Do not prefix these with VITE_ or place them under client/.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Random value of at least 32 characters; identical on every API instance.
QUOTE_RATE_LIMIT_SECRET=

# Optional sales notification. Requests remain saved if email is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Wyztec <sales@wyztec.com>
SALES_EMAIL=sales@wyztec.com
